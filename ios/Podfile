# 高德 iOS 地图 SDK
#
# 高德只能通过 CocoaPods 集成（官方没有 SPM 支持），所以 CI 里多一步 pod install，
# 之后必须用生成的 CarDash.xcworkspace 构建，不能用 .xcodeproj。
#
# 用 -NO-IDFA 版本：我们不需要广告标识符，省得审核时多填一堆说明。
#
# 路径规划**不**用 AMapSearch —— 直接调高德的 Web 服务接口，
# 这样 Web 平台那个 Key 用得上，pod 也少一个。
platform :ios, '16.0'

target 'CarDash' do
  use_frameworks!
  pod 'AMap3DMap-NO-IDFA'
end
